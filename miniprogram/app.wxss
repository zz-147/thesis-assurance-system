/**
 * 全局样式。只使用 WXSS 支持的 class 选择器，不依赖第三方 UI 库。
 */
page {
  background: #f4f6fb;
  color: #1f2937;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  padding-bottom: 40rpx;
}

.page {
  padding: 24rpx 24rpx 8rpx;
  box-sizing: border-box;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(15, 23, 42, 0.06);
  box-sizing: border-box;
}

/* -- 文字 -------------------------------------------------------------- */
.muted {
  color: #64748b;
}

.small {
  font-size: 24rpx;
}

.link {
  color: #2563eb;
  font-size: 26rpx;
}

.required {
  color: #dc2626;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 8rpx 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.section-count {
  font-size: 24rpx;
  color: #64748b;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.toggle {
  font-size: 26rpx;
  color: #2563eb;
  padding: 6rpx 16rpx;
  background: #eff6ff;
  border-radius: 999rpx;
}

/* -- 表单 -------------------------------------------------------------- */
.field {
  margin-bottom: 24rpx;
}

.field-label {
  font-size: 26rpx;
  color: #334155;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.input,
.textarea,
.picker-value {
  width: 100%;
  box-sizing: border-box;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 20rpx 22rpx;
  font-size: 28rpx;
  color: #1f2937;
}

.textarea {
  min-height: 120rpx;
  line-height: 1.5;
}

.input-placeholder {
  color: #94a3b8;
}

.picker-value.is-placeholder {
  color: #94a3b8;
}

.field-tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.form-hint {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.5;
}

/* -- 按钮（覆盖小程序 button 默认样式） -------------------------------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 88rpx;
  margin: 0;
  padding: 0 32rpx;
  border: none;
  border-radius: 44rpx;
  background: #eff6ff;
  color: #1d4ed8;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
  box-sizing: border-box;
}

.btn::after {
  border: none;
}

.btn-block {
  width: 100%;
}

.btn-primary {
  background: #2563eb;
  color: #ffffff;
}

.btn-ghost {
  background: #eff6ff;
  color: #1d4ed8;
}

.btn-plain {
  background: #f1f5f9;
  color: #334155;
}

.btn-mini {
  width: auto;
  height: 64rpx;
  padding: 0 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
}

.btn-loading {
  opacity: 0.65;
}

/* -- 状态块 ------------------------------------------------------------ */
.state-box {
  padding: 64rpx 32rpx;
  text-align: center;
}

.state-box.inner {
  padding: 40rpx 16rpx;
}

.state-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #334155;
}

.state-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 1.6;
}

.state-action {
  display: flex;
  justify-content: center;
  margin-top: 24rpx;
}

.state-action .btn {
  margin: 0 8rpx;
}

/* -- 标签 -------------------------------------------------------------- */
.code-chip {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: #eff6ff;
  color: #1d4ed8;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.code-chip.big {
  font-size: 30rpx;
  padding: 8rpx 20rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.tag-pass {
  background: #dcfce7;
  color: #166534;
}

.tag-fail {
  background: #fee2e2;
  color: #b91c1c;
}

.tag-warn {
  background: #fef3c7;
  color: #92400e;
}

.chip {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.chip-error {
  background: #fee2e2;
  color: #b91c1c;
}

.chip-warning {
  background: #fef3c7;
  color: #92400e;
}

.chip-info {
  background: #e0f2fe;
  color: #075985;
}

/* -- 键值行（列表/详情共用） ------------------------------------------ */
.meta-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-top: 6rpx;
  font-size: 24rpx;
}

.meta-value {
  margin-left: 24rpx;
  max-width: 65%;
  text-align: right;
  color: #334155;
  word-break: break-all;
}

.due-past {
  color: #dc2626;
}

/* -- 底部提示 ---------------------------------------------------------- */
.footer-tip {
  padding: 16rpx 8rpx 40rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b6c2d4;
}
